{
  "name": "backend",
  "version": "1.0.0",
  "description": "Mentat FC API \u2014 serves the app, reads predictions from Postgres",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:create": "node-pg-migrate create -j sql --",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "db:seed": "tsx seed/index.ts",
    "db:seed:current-season": "tsx seed/current-season.ts",
    "db:seed:logos": "tsx seed/backfill-logos.ts",
    "db:seed:photos": "tsx seed/backfill-photos.ts",
    "db:seed:fpl": "tsx seed/backfill-fpl.ts",
    "db:seed:backfill-lineups": "tsx seed/backfill-lineups.ts",
    "db:seed:matchday-lineups": "tsx seed/matchday-lineups.ts",
    "db:seed:repair-duplicate-players": "tsx seed/repair-duplicate-players.ts",
    "db:dump": "tsx seed/dump.ts",
    "db:restore": "tsx seed/restore.ts",
    "check:lineup-depth": "tsx seed/check-lineup-depth.ts",
    "check:bulk-fixtures": "tsx seed/check-bulk-fixtures-endpoint.ts",
    "check:squads-endpoint": "tsx seed/check-squads-endpoint.ts",
    "db:seed:shot-location": "tsx seed/backfill-shot-location.ts",
    "db:seed:upcoming-odds": "tsx seed/upcoming-odds.ts"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
