PORT=4000

# Signs and verifies login JWTs -- any long random string, but treat it like
# a password: rotating it instantly invalidates every issued token (everyone
# gets logged out). Generate one with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# Matches docker-compose.yml Postgres defaults — update user/password/db to match your .env
# No Docker on this machine? Use a free Neon (neon.tech) connection string here
# instead -- see docs/seeding-runbook.md's "No Docker available?" section.
DATABASE_URL=postgresql://mentat:mentat_dev_password@localhost:5432/mentat_fc

# Fixtures / lineups / standings (API-Football or Football-Data.org — pick one, see docs/learning-log.md)
API_FOOTBALL_KEY=your_api_football_key_here

# The Odds API — for betting tracker's model-vs-market comparison
ODDS_API_KEY=your_odds_api_key_here

# Groq API — Llama 3.3 70B, used by the AI explainer feature
GROQ_API_KEY=your_groq_api_key_here

# No FPL_ENTRY_ID here anymore -- each user links their own FPL team/entry
# ID from the My Team page (POST /api/fpl/link), stored on their own user
# row. No FPL login/key needed there either -- entry data is public if you
# know the ID.
