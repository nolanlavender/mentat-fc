PORT=4000

# Matches docker-compose.yml Postgres defaults — update user/password/db to match your .env
DATABASE_URL=postgresql://mentat:mentat_dev_password@localhost:5432/mentat_fc

# Fixtures / lineups / standings (API-Football or Football-Data.org — pick one, see docs/learning-log.md)
API_FOOTBALL_KEY=your_api_football_key_here

# The Odds API — for betting tracker's model-vs-market comparison
ODDS_API_KEY=your_odds_api_key_here

# Groq API — Llama 3.3 70B, used by the AI explainer feature
GROQ_API_KEY=your_groq_api_key_here

# Your personal FPL team/entry ID, for GET /api/fpl/my-team. Find it by
# clicking your manager name or "Gameweek History" on fantasy.premierleague.com
# and reading the number out of the URL (e.g. .../entry/1234567/...). No FPL
# login/key needed here -- entry data is public if you know the ID. Optional:
# the backend runs fine without this set, that one endpoint just won't work.
FPL_ENTRY_ID=your_fpl_entry_id_here
